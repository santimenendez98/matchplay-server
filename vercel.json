{
  "version": 2,
  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "DISABLE_CRON": "true"
  },
  "crons": [
    {
      "path": "/api/cron/daily-maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
