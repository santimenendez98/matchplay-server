# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Base URL of the frontend (used to build MercadoPago back_urls like
# success/failure/pending). Must match the dev server URL or the deployed
# frontend domain.
FRONTEND_URL=http://localhost:5173

# Public base URL of this backend (used as MercadoPago notification_url for
# webhooks). In local dev MercadoPago cannot reach `localhost`; use ngrok or
# the dashboard's "Test webhook" tool.
API_BASE_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://user:password@host:port/database

# --- JWT ---
JWT_SECRET=replace-me
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# --- MercadoPago ---
# Access token from your MercadoPago application (Test or Production).
MERCADO_PAGO_ACCESS_TOKEN=your_mercadopago_access_token
# Webhook signing secret from the MercadoPago application's "Webhooks" tab.
# The /api/payment/webhook handler verifies the x-signature header against this.
MERCADO_PAGO_WEBHOOK_SECRET=replace-me

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Cron (Vercel Cron / external scheduler) ---
CRON_SECRET=replace-with-strong-secret
# Set DISABLE_CRON=true to skip in-process node-cron jobs (use HTTP endpoints
# under /api/cron instead — required on Vercel / serverless).
# DISABLE_CRON=true
